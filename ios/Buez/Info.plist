<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<!-- Combined URL Schemes -->
	<key>CFBundleURLTypes</key>
	<array>
		<!-- Custom app scheme -->
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>buez</string>
			</array>
		</dict>
		<!-- Google Sign-In -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.291364316025-4kor9g99j9huha1mlr9jvtbv7k5n4t1k</string>
			</array>
		</dict>
		<!-- Facebook -->
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fb716889610970681</string>
			</array>
		</dict>
	</array>

	<!-- Facebook App Config -->
	<key>FacebookAppID</key>
	<string>716889610970681</string>
	<key>FacebookDisplayName</key>
	<string>Buez Social</string>

	<!-- LSApplicationQueriesSchemes -->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fbapi</string>
		<string>fb-messenger-api</string>
		<string>fbauth2</string>
		<string>fbshareextension</string>
		<string>google</string>
		<string>com.googleusercontent.apps.291364316025-4kor9g99j9huha1mlr9jvtbv7k5n4t1k</string>
	</array>

	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>

	<!-- Location Usage Descriptions -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>This app requires access to your location while it is in use to enhance your experience.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>This app requires access to your location even when the app is in the background to provide better service.</string>

	<!-- App Transport Security settings for Stripe and Backend -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Allow all requests in dev/testing -->
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<!-- Exceptions -->
		<key>NSExceptionDomains</key>
		<dict>
			<!-- Stripe API -->
			<key>api.stripe.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSTemporaryExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSTemporaryExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
			</dict>
			<!-- Your Vercel backend -->
			<key>buez-server-khaki.vercel.app</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSTemporaryExceptionAllowsInsecureHTTPLoads</key>
				<true/>
				<key>NSTemporaryExceptionMinimumTLSVersion</key>
				<string>TLSv1.2</string>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
